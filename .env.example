# ==============================================================================
# KAIRO: Environment Configuration
# ==============================================================================

# Application & Environments
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 17+)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kairo:kairo_dev_secret@localhost:5432/kairo
DATABASE_URL_SYNC=postgresql://kairo:kairo_dev_secret@localhost:5432/kairo

# ------------------------------------------------------------------------------
# Object Storage (MinIO in local dev, S3 in prod)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kairo_minio_admin
S3_SECRET_KEY=kairo_minio_password
S3_BUCKET_SNAPSHOTS=kairo-snapshots
S3_BUCKET_REPORTS=kairo-reports
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# Authentication (GitHub OAuth & Session)
# ------------------------------------------------------------------------------
# In local development, defaults point to infra/mock-github
GITHUB_CLIENT_ID=kairo_dev_client_id
GITHUB_CLIENT_SECRET=kairo_dev_client_secret
GITHUB_OAUTH_URL=http://localhost:8080/login/oauth/authorize
GITHUB_TOKEN_URL=http://localhost:8080/login/oauth/access_token
GITHUB_API_URL=http://localhost:8080/api/v3

# Session Encryption and Cookie Security
# Must be at least 32 characters long
SESSION_SECRET=kairo_dev_session_secret_32_characters_minimum!
SESSION_COOKIE_NAME=__Host-kairo_session
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
ENCRYPTION_KEY_SECRET=kairo_dev_snapshot_encryption_key_32chars!

# ------------------------------------------------------------------------------
# AI-Assisted Logic Review (LR-14: Fail-closed gate)
# ------------------------------------------------------------------------------
# AI review is strictly disabled until the owner authorizes a provider review
AI_REVIEW_ENABLED=false
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=

# ------------------------------------------------------------------------------
# Dynamic Runner & Sandbox Link
# ------------------------------------------------------------------------------
RUNNER_SECRET=kairo_dev_runner_wireguard_token
SANDBOX_TIMEOUT_SECONDS=300
